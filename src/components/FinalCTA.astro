---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section class="relative py-14 md:py-20">
  <div class="section-shell">
    <div class="dossier-panel rounded-lg p-5 md:p-8">
      <div class="grid grid-cols-1 gap-7 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="coord text-accent">Next conversation</p>
          <h2 class="section-heading mt-4 max-w-3xl text-3xl md:text-5xl">
            Bring me the messy process, overlooked dataset, or product question.
          </h2>
          <p class="section-copy mt-5 max-w-2xl text-base md:text-lg">
            I am interested in roles and collaborations where cross-industry judgment, AI-assisted
            development, data, and product thinking can turn ambiguity into a working system.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href={`${base}/resume.pdf`} class="button-secondary">Resume</a>
          <a href="https://www.linkedin.com/in/alex-schulz13/" target="_blank" rel="noopener noreferrer" class="button-secondary">LinkedIn</a>
          <a href="mailto:alex.j.schulz@gmail.com" class="button-primary">Email Alex</a>
        </div>
      </div>
    </div>
  </div>
</section>

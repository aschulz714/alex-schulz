---
import { contact, resumePath } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const resumeUrl = resumePath ? `${base}/${resumePath}` : null;
---

<section class="py-14 md:py-20">
  <div class="shell">
    <div class="plate p-6 md:p-10">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="eyebrow eyebrow-signal">Get in touch</p>
          <h2 class="display mt-3 max-w-2xl text-3xl md:text-5xl">
            Want to see any of this run? Write to me.
          </h2>
          <p class="copy mt-4 max-w-2xl text-base">
            I'm happy to walk through how any of these were built. For Item2 or the trip app, email is the fastest way to reach me.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          {resumeUrl && <a href={resumeUrl} class="btn-ghost">Resume</a>}
          <a href={contact.linkedIn} target="_blank" rel="noopener noreferrer" class="btn-ghost">LinkedIn</a>
          <a href={`mailto:${contact.email}`} class="btn">Email Alex</a>
        </div>
      </div>
    </div>
  </div>
</section>

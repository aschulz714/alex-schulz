---
import { heroPlaces as places } from '../data/profile';

const blocks = [
  {
    label: 'Credentials',
    body: 'CPA · MS GEOINT',
    note: 'USGIF-accredited (UMD). Combination held by ~10–20 in the U.S.',
  },
  {
    label: 'Family offices',
    body: 'Vulcan Inc. · McCaw family office',
    note: 'Real-estate finance and operations, Seattle.',
  },
  {
    label: 'Productions',
    body: 'Twin Peaks: The Return · 7 Minutes · The Amazing Race',
    note: 'Production accounting. Two IMDB credits (nm5681118); Race off-credit.',
  },
  {
    label: 'Active builds',
    body: 'Item2 · Hodego · North Kai Capital',
    note: 'Satellite signals on micro-caps. AWS logistics. ETF-licensable franchise-company index, developed with EQM Indexes.',
  },
  {
    label: 'Tool layer',
    body: 'AI across the work',
    note: 'Geospatial analysis, finance research, copy, and the building of this site.',
  },
];

const heroHighlights = [
  {
    label: 'Unusual overlap',
    body: 'CPA + MS GEOINT',
    note: 'Accounting discipline crossed with geospatial intelligence and physical-world evidence.',
  },
  {
    label: 'Source worlds',
    body: 'Sets + maps + markets',
    note: 'Production accounting, family offices, parcel records, public markets, and backstage logistics.',
  },
  {
    label: 'Current direction',
    body: 'AI as the tool layer',
    note: 'Turning overlooked signals into maps, market research, product experiments, and better questions.',
  },
];

const today = new Date('2026-05-13');
const stamp = today.toISOString().slice(0, 10);
---

<section class="relative overflow-hidden">
  <div class="section-shell pt-10 pb-14 md:pt-16 md:pb-20">
    <div class="dossier-panel rounded-lg">
      {/* Dossier header strip */}
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline px-5 py-3 md:px-8">
        <p class="coord text-accent">Issue 01 / Subject profile</p>
        <p class="coord rev-stamp">
          <span class="rev-dot" aria-hidden="true">●</span>
          Rev. {stamp} · Lake Stevens field office
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr]">
        <div class="border-b border-hairline p-5 md:border-b-0 md:border-r md:p-8 lg:p-10">
          <div class="mb-6 flex flex-wrap items-center gap-3">
            <p class="coord text-accent">Alex Schulz / 2026</p>
            <span class="coord rounded-sm border border-signal/30 bg-signal-soft px-2 py-1 text-signal">
              Working dossier
            </span>
          </div>

          <h1 class="section-heading text-5xl leading-[0.96] sm:text-6xl md:text-6xl lg:text-7xl">
            Alex Schulz
          </h1>
          <p class="mono mt-3 text-sm uppercase tracking-[0.18em] text-ink-muted md:text-base">
            Lake Stevens, WA · 47.979°N 122.202°W
          </p>
          <p class="mt-6 max-w-2xl text-xl font-semibold leading-snug text-ink-soft md:text-2xl">
            I look for the overlooked operating layer behind shows, places, and numbers, then turn
            what I find into maps, market research, and working products.
          </p>
          <p class="section-copy mt-4 max-w-2xl text-base md:text-lg">
            Entertainment taught me to see the production system. Geospatial work taught me to read
            physical evidence. Finance taught me to ask who owns the upside. AI is the tool layer
            that lets those instincts compound.
          </p>

          {/* Intelligence blocks */}
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3">
            {heroHighlights.map((block) => (
              <article class="surface-quiet rounded-md p-4 md:p-5">
                <p class="coord text-accent">{block.label}</p>
                <p class="mt-3 font-sans text-base font-semibold leading-snug text-ink md:text-lg">
                  {block.body}
                </p>
                <p class="mt-2 text-xs leading-relaxed text-ink-muted md:text-sm">
                  {block.note}
                </p>
              </article>
            ))}
          </div>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#artifacts" class="button-primary">Source materials <span class="mono text-xs" aria-hidden="true">-&gt;</span></a>
            <a href="/lenses" class="button-secondary">Explore lenses <span class="mono text-xs" aria-hidden="true">-&gt;</span></a>
            <a href="mailto:alex.j.schulz@gmail.com" class="button-secondary">Contact</a>
          </div>
        </div>

        <div class="flex min-h-[34rem] flex-col p-3 md:min-h-0 md:p-4">
          <div class="mb-3 flex items-center justify-between gap-3 px-1">
            <p class="coord text-accent">Places that shaped the lens</p>
            <p class="coord">Personal atlas</p>
          </div>
          <div class="relative min-h-[24rem] flex-1 md:min-h-0">
            <div
              id="hero-map"
              class="relative h-full min-h-[24rem] overflow-hidden rounded-md border border-hairline bg-accent-soft md:min-h-0"
            ></div>

            <div class="absolute left-3 top-3 max-w-[calc(100%-1.5rem)] rounded-sm border border-hairline bg-paper-soft/92 px-3 py-2 backdrop-blur">
              <p id="place-label" class="coord text-accent">{places[0].label}</p>
              <p id="place-note" class="mt-1 text-xs leading-snug text-ink-soft">{places[0].note}</p>
            </div>

            <p id="place-coord" class="coord mono absolute bottom-3 right-3 rounded-sm border border-hairline bg-paper-soft/90 px-2 py-1 backdrop-blur">
              {places[0].coords[1].toFixed(3)}, {places[0].coords[0].toFixed(3)}
            </p>
          </div>

          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {places.map((place, index) => (
              <button
                type="button"
                class={`place-button ${index === 0 ? 'is-active' : ''}`}
                data-place-index={index}
              >
                <span class="mono text-[0.65rem]">{String(index + 1).padStart(2, '0')}</span>
                <span>{place.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" id="hero-places-data" set:html={JSON.stringify(places)}></script>
</section>

<style>
  @keyframes rev-pulse {
    0%, 100% { opacity: 0.7; }
    50%      { opacity: 1; }
  }
  @keyframes rev-dot-pulse {
    0%, 100% { opacity: 0.35; transform: scale(0.9); }
    50%      { opacity: 1;    transform: scale(1.05); }
  }
  .rev-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    animation: rev-pulse 7s ease-in-out infinite;
  }
  .rev-dot {
    color: var(--color-signal);
    font-size: 0.55rem;
    line-height: 1;
    display: inline-block;
    animation: rev-dot-pulse 2.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .rev-stamp { animation: none; opacity: 0.9; }
    .rev-dot   { animation: none; opacity: 0.6; transform: none; }
  }
</style>

<script>
  type Place = {
    label: string;
    note: string;
    coords: [number, number];
    zoom: number;
  };

  const placesData = document.getElementById('hero-places-data');
  const places = JSON.parse(placesData?.textContent ?? '[]') as Place[];
  const HOME = places[0]?.coords ?? [-122.2021, 47.979];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mapContainer = document.getElementById('hero-map');
  const labelEl = document.getElementById('place-label');
  const noteEl = document.getElementById('place-note');
  const coordEl = document.getElementById('place-coord');
  const placeButtons = document.querySelectorAll<HTMLButtonElement>('.place-button[data-place-index]');

  if (mapContainer && places.length) {
    const markerEls: HTMLElement[] = [];
    let map: import('maplibre-gl').Map | null = null;
    let currentIdx = 0;
    let driftTimer: number | null = null;
    let driftPauseUntil = 0;

    function paintCoord(lat: number, lng: number) {
      if (coordEl) coordEl.textContent = `${lat.toFixed(3)}, ${lng.toFixed(3)}`;
    }

    function driftTick() {
      if (prefersReducedMotion) return;
      if (Date.now() < driftPauseUntil) return;
      const place = places[currentIdx];
      if (!place) return;
      // Subtle GPS-style settle. ±0.0015 lat/lng, well below visible precision shift.
      const lat = place.coords[1] + (Math.random() - 0.5) * 0.003;
      const lng = place.coords[0] + (Math.random() - 0.5) * 0.003;
      paintCoord(lat, lng);
    }

    function startDrift() {
      if (prefersReducedMotion || driftTimer !== null) return;
      driftTimer = window.setInterval(driftTick, 1800);
    }

    function setPlace(index: number, fly = true) {
      const place = places[index];
      if (!place) return;

      currentIdx = index;
      driftPauseUntil = Date.now() + 1600; // brief settle on the precise coord

      placeButtons.forEach((button, i) => button.classList.toggle('is-active', i === index));
      markerEls.forEach((marker, i) => marker.classList.toggle('is-active', i === index));
      if (labelEl) labelEl.textContent = place.label;
      if (noteEl) noteEl.textContent = place.note;
      paintCoord(place.coords[1], place.coords[0]);

      if (fly && map) {
        map.flyTo({
          center: place.coords,
          zoom: place.zoom,
          duration: prefersReducedMotion ? 0 : 1100,
          essential: true,
        });
      }
    }

    async function initMap() {
      await import('maplibre-gl/dist/maplibre-gl.css');
      const { default: maplibregl } = await import('maplibre-gl');

      map = new maplibregl.Map({
        container: mapContainer,
        style: 'https://tiles.openfreemap.org/styles/positron',
        center: HOME,
        zoom: places[0]!.zoom,
        interactive: false,
        attributionControl: { compact: true },
        pitchWithRotate: false,
        dragRotate: false,
      });

      map.on('load', () => {
      mapContainer.classList.add('map-ready');

      const style = map!.getStyle();
      (style.layers ?? []).forEach((layer) => {
        if (layer.type === 'symbol') {
          map!.setLayoutProperty(layer.id, 'visibility', 'none');
        }
      });

      places.forEach((place, index) => {
        const marker = document.createElement('button');
        marker.type = 'button';
        marker.className = `hero-map-marker ${index === 0 ? 'is-active' : ''}`;
        marker.textContent = String(index + 1).padStart(2, '0');
        marker.setAttribute('aria-label', place.label);
        marker.addEventListener('click', () => setPlace(index));
        markerEls.push(marker);
        new maplibregl.Marker({ element: marker, anchor: 'center' }).setLngLat(place.coords).addTo(map!);
      });

      startDrift();
    });
    }

    if ('IntersectionObserver' in window) {
      const mapObserver = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            mapObserver.disconnect();
            initMap();
          }
        },
        { rootMargin: '220px 0px' }
      );
      mapObserver.observe(mapContainer);
    } else {
      initMap();
    }

    placeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setPlace(Number(button.dataset.placeIndex ?? 0));
      });
    });
  }
</script>

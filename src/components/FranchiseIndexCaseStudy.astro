---
import throughCurrentSummary from '../../data-sources/franchise-index/franchise_performance_summary.json';
import throughCurrentAnnualReturns from '../../data-sources/franchise-index/franchise_performance_annual_returns.json';
import throughCurrentSeries from '../../data-sources/franchise-index/franchise_performance_series.json';
import originalSummary from '../../data-sources/franchise-index/index_reconstruction_summary.json';

type SeriesPoint = {
  date: string;
  franchise_level: number;
  benchmark_spy_level: number;
};

type AnnualReturn = {
  year: string;
  franchise_return: number;
  benchmark_return: number;
};

const pct = (value: number, digits = 1) =>
  `${(value * 100).toLocaleString('en-US', {
    maximumFractionDigits: digits,
    minimumFractionDigits: digits,
  })}%`;

const multiple = (level: number) => `${(level / 100).toFixed(1)}x`;
const formatDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });

const sampledSeries = (throughCurrentSeries as SeriesPoint[]).filter((point, index, rows) => {
  if (index === 0 || index === rows.length - 1) return true;
  const prev = rows[index - 1];
  return point.date.slice(0, 7) !== prev.date.slice(0, 7);
});

const annualReturns = throughCurrentAnnualReturns as AnnualReturn[];
const chartValues = sampledSeries.flatMap((point) => [point.franchise_level, point.benchmark_spy_level]);
const minLevel = Math.min(...chartValues);
const maxLevel = Math.max(...chartValues);
const chartWidth = 900;
const chartHeight = 330;
const pad = { top: 24, right: 26, bottom: 34, left: 42 };
const innerWidth = chartWidth - pad.left - pad.right;
const innerHeight = chartHeight - pad.top - pad.bottom;
const yMin = Math.max(0, Math.floor(minLevel / 50) * 50);
const yMax = Math.ceil(maxLevel / 50) * 50;
const xFor = (index: number) =>
  pad.left + (sampledSeries.length <= 1 ? 0 : (index / (sampledSeries.length - 1)) * innerWidth);
const yFor = (level: number) =>
  pad.top + ((yMax - level) / (yMax - yMin)) * innerHeight;
const pathFor = (key: 'franchise_level' | 'benchmark_spy_level') =>
  sampledSeries
    .map((point, index) => `${index === 0 ? 'M' : 'L'} ${xFor(index).toFixed(2)} ${yFor(point[key]).toFixed(2)}`)
    .join(' ');
const gridLines = [100, 250, 400, 550, 700].filter((line) => line >= yMin && line <= yMax);
const yearTicks = ['2008', '2012', '2016', '2020', '2024'];
const tickForYear = (year: string) => {
  const index = sampledSeries.findIndex((point) => point.date.startsWith(year));
  return index >= 0 ? xFor(index) : null;
};
const barRows = annualReturns.slice(-9);
const maxAbsReturn = Math.max(
  ...barRows.flatMap((row) => [Math.abs(row.franchise_return), Math.abs(row.benchmark_return)])
);

const originSteps = [
  {
    label: 'Observation',
    title: 'A Jack in the Box refranchising thesis made the category click.',
    body:
      'A winning Value Investing Congress writeup framed refranchising as a way to turn operating complexity into asset-light royalty economics. The natural next question was whether a basket of public franchise businesses could capture the same pattern.',
  },
  {
    label: 'Market gap',
    title: 'The RCF / RIFC 50 showed the idea existed, but not as a commercial product.',
    body:
      'The category had academic evidence and industry logic, but it had not been packaged into the kind of index that could be licensed into an ETF.',
  },
  {
    label: 'Network',
    title: 'Industry outreach turned the hunch into a build path.',
    body:
      'ETF founder Christian Magoon connected Alex with Jane Edmondson at EQM Indexes, which created a path from personal thesis to formal methodology.',
  },
  {
    label: 'Build',
    title: 'North Kai and EQM developed a licensable franchise-company index.',
    body:
      'The methodology used public-company franchise exposure, liquidity screens, and quality-oriented weighting with the goal of making the concept available for ETF licensing.',
  },
];
---

<section id="franchise-index" class="relative py-14 md:py-24">
  <div class="section-shell">
    <div class="mb-10 grid grid-cols-1 gap-7 md:mb-14 md:grid-cols-[180px_1fr] md:gap-14">
      <p class="coord pt-1">01 / Franchise thesis</p>
      <div>
        <h2 class="section-heading max-w-3xl text-3xl md:text-5xl">
          I turned a refranchising hunch into an index methodology.
        </h2>
        <p class="section-copy mt-5 max-w-2xl text-base md:text-lg">
          The point is not that one backtest should be frozen in amber. The point is pattern
          recognition: noticing a business model hiding in plain sight, finding the commercial gap,
          and building a structured product around it.
        </p>
      </div>
    </div>

    <div class="dossier-panel overflow-hidden rounded-lg">
      <div class="grid grid-cols-1 border-b border-hairline md:grid-cols-[0.95fr_1.35fr]">
        <div class="border-b border-hairline p-5 md:border-b-0 md:border-r md:p-6 lg:p-7">
          <p class="coord text-accent">North Kai Capital / EQM Indexes</p>
          <h3 class="mt-5 font-sans text-2xl font-semibold leading-tight text-ink md:text-3xl">
            Publicly traded franchise businesses, tested against the S&amp;P 500.
          </h3>
          <p class="section-copy mt-4 text-sm md:text-base">
            The original reconstruction wins strongly through the launch-era window. Extended to
            2026, the S&amp;P catches up as mega-cap technology dominates the benchmark. That is the
            useful signal: franchise quality worked, then the market regime changed.
          </p>

          <dl class="mt-7 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-hairline pt-5">
            <div class="dossier-stat">
              <dt class="coord text-accent">2007-2017</dt>
              <dd class="mt-2 text-2xl font-semibold text-ink md:text-3xl">
                {pct(originalSummary.franchise_annualized_return)}
              </dd>
              <dd class="mt-1 text-xs leading-snug text-ink-muted">
                annualized vs {pct(originalSummary.benchmark_annualized_return)} for SPY
              </dd>
            </div>
            <div class="dossier-stat">
              <dt class="coord text-accent">2007-2026</dt>
              <dd class="mt-2 text-2xl font-semibold text-ink md:text-3xl">
                {multiple(throughCurrentSummary.franchise_end_level)}
              </dd>
              <dd class="mt-1 text-xs leading-snug text-ink-muted">
                cumulative level vs {multiple(throughCurrentSummary.benchmark_end_level)} for SPY
              </dd>
            </div>
            <div class="dossier-stat">
              <dt class="coord text-accent">Current through</dt>
              <dd class="mt-2 text-lg font-semibold text-ink">
                {formatDate(throughCurrentSummary.end_date)}
              </dd>
              <dd class="mt-1 text-xs leading-snug text-ink-muted">
                built from archived holdings and EODHD price history
              </dd>
            </div>
            <div class="dossier-stat">
              <dt class="coord text-accent">Next version</dt>
              <dd class="mt-2 text-lg font-semibold text-ink">
                Quality + AI
              </dd>
              <dd class="mt-1 text-xs leading-snug text-ink-muted">
                refresh the thesis with cleaner data and sharper rules
              </dd>
            </div>
          </dl>
        </div>

        <div class="p-4 md:p-6 lg:p-7">
          <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="coord text-accent">Cumulative performance</p>
              <p class="mt-2 text-sm text-ink-muted">
                Base 100 on Dec. 31, 2007
              </p>
            </div>
            <div class="flex flex-wrap gap-3 text-xs text-ink-muted">
              <span class="inline-flex items-center gap-2">
                <span class="h-0.5 w-7 rounded-full bg-accent"></span>
                Franchise basket
              </span>
              <span class="inline-flex items-center gap-2">
                <span class="h-0.5 w-7 rounded-full bg-signal"></span>
                SPY
              </span>
            </div>
          </div>

          <div class="performance-chart rounded-md border border-hairline bg-paper-soft/75">
            <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img" aria-labelledby="franchise-chart-title franchise-chart-desc" preserveAspectRatio="none">
              <title id="franchise-chart-title">Franchise index reconstruction versus SPY</title>
              <desc id="franchise-chart-desc">
                Cumulative performance from 2007 through 2026. The franchise basket leads through the
                original reconstruction window before SPY catches up in the later mega-cap technology period.
              </desc>

              {gridLines.map((line) => (
                <g>
                  <line
                    x1={pad.left}
                    x2={chartWidth - pad.right}
                    y1={yFor(line)}
                    y2={yFor(line)}
                    class="chart-grid"
                  />
                  <text x={pad.left - 10} y={yFor(line) + 4} text-anchor="end" class="chart-axis-label">
                    {line}
                  </text>
                </g>
              ))}

              {yearTicks.map((year) => {
                const x = tickForYear(year);
                return x === null ? null : (
                  <text x={x} y={chartHeight - 10} text-anchor="middle" class="chart-axis-label">
                    {year}
                  </text>
                );
              })}

              <path d={pathFor('benchmark_spy_level')} class="chart-line chart-line-spy" />
              <path d={pathFor('franchise_level')} class="chart-line chart-line-franchise" />
              <line
                x1={tickForYear('2018') ?? 0}
                x2={tickForYear('2018') ?? 0}
                y1={pad.top}
                y2={chartHeight - pad.bottom}
                class="chart-marker"
              />
              <text x={(tickForYear('2018') ?? 0) + 8} y={pad.top + 13} class="chart-axis-label chart-callout">
                launch-era reconstruction ends
              </text>
            </svg>
          </div>

          <p class="mt-3 text-xs leading-relaxed text-ink-muted">
            Draft reconstruction for portfolio storytelling, not an official index record or investment
            advice. The through-current series uses historical holdings, approved securities, and current
            provider data.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[0.9fr_1.1fr]">
        <div class="border-b border-hairline p-5 md:border-b-0 md:border-r md:p-6 lg:p-7">
          <p class="coord text-signal">Origin story</p>
          <ol class="mt-5 space-y-5">
            {originSteps.map((step, index) => (
              <li class="grid grid-cols-[2.4rem_1fr] gap-4">
                <span class="timeline-number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <p class="coord text-accent">{step.label}</p>
                  <h4 class="mt-2 font-sans text-lg font-semibold leading-snug text-ink">
                    {step.title}
                  </h4>
                  <p class="section-copy mt-2 text-sm">
                    {step.body}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="p-5 md:p-6 lg:p-7">
          <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="coord text-accent">Recent annual returns</p>
              <h3 class="mt-3 font-sans text-2xl font-semibold leading-tight text-ink">
                The old thesis needs a modern filter.
              </h3>
            </div>
          </div>

          <div class="space-y-3">
            {barRows.map((row) => {
              const franchiseWidth = `${Math.max(6, (Math.abs(row.franchise_return) / maxAbsReturn) * 100).toFixed(1)}%`;
              const benchmarkWidth = `${Math.max(6, (Math.abs(row.benchmark_return) / maxAbsReturn) * 100).toFixed(1)}%`;
              return (
                <div class="grid grid-cols-[3rem_1fr] gap-3 text-sm md:grid-cols-[3.5rem_1fr]">
                  <p class="mono pt-1 text-xs text-ink-muted">{row.year}</p>
                  <div class="space-y-1.5">
                    <div class="grid grid-cols-[4.5rem_1fr_3.8rem] items-center gap-2">
                      <span class="coord text-accent">Franchise</span>
                      <span class={`return-bar ${row.franchise_return < 0 ? 'is-negative' : ''}`}>
                        <span style={`width:${franchiseWidth}`}></span>
                      </span>
                      <span class="mono text-right text-xs text-ink-soft">{pct(row.franchise_return, 0)}</span>
                    </div>
                    <div class="grid grid-cols-[4.5rem_1fr_3.8rem] items-center gap-2">
                      <span class="coord text-signal">SPY</span>
                      <span class={`return-bar is-spy ${row.benchmark_return < 0 ? 'is-negative' : ''}`}>
                        <span style={`width:${benchmarkWidth}`}></span>
                      </span>
                      <span class="mono text-right text-xs text-ink-soft">{pct(row.benchmark_return, 0)}</span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          <div class="mt-7 border-t border-hairline pt-5">
            <p class="section-copy text-sm md:text-base">
              The next version should not merely replay the old basket. It should ask what still
              matters about franchise economics now: royalty durability, unit growth, leverage,
              valuation, brand strength, real-estate exposure, and whether AI can monitor the
              physical footprint behind the filings.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .performance-chart {
    height: 20rem;
    overflow: hidden;
  }

  .performance-chart svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .chart-grid {
    stroke: rgba(14, 23, 20, 0.12);
    stroke-width: 1;
  }

  .chart-axis-label {
    fill: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .chart-callout {
    fill: var(--color-signal);
  }

  .chart-line {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .chart-line-franchise {
    stroke: var(--color-accent);
  }

  .chart-line-spy {
    stroke: var(--color-signal);
  }

  .chart-marker {
    stroke: rgba(189, 86, 48, 0.38);
    stroke-dasharray: 5 7;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .return-bar {
    display: flex;
    height: 0.62rem;
    align-items: stretch;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(14, 23, 20, 0.08);
  }

  .return-bar span {
    display: block;
    border-radius: inherit;
    background: var(--color-accent);
  }

  .return-bar.is-spy span {
    background: var(--color-signal);
  }

  .return-bar.is-negative span {
    opacity: 0.45;
  }

  @media (max-width: 640px) {
    .performance-chart {
      height: 16rem;
    }
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { toRoman } from '../lib/roman';

export interface Props {
  entry: CollectionEntry<'projects'>;
  plate: number;
  size?: 'lead' | 'std' | 'compact';
}

const { entry, plate, size = 'std' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const figure = entry.data.figure;
const figureSrc = figure
  ? /^https?:\/\//.test(figure.src)
    ? figure.src
    : `${base}/${figure.src.replace(/^\/+/, '')}`
  : undefined;
const showImage = figure && (figure.kind ?? 'image') === 'image';

const categoryLabel: Record<string, string> = {
  'ai-automation': 'AI + automation',
  'data-systems': 'Data system',
  geospatial: 'Geospatial',
  product: 'Product',
  python: 'Python / data',
  web: 'Web product',
};

const ratio = size === 'lead' ? '16/9' : size === 'compact' ? '3/2' : '16/10';
const fitClass = (figure?.fit ?? 'contain') === 'contain' ? 'fit-contain' : undefined;
const stats = entry.data.scale.slice(0, size === 'lead' ? 3 : 2);
// One ledger column per stat, so two stats don't leave an empty third column.
const statCols = stats.length >= 3 ? 'sm:grid-cols-3' : stats.length === 2 ? 'sm:grid-cols-2' : '';
---

<a
  href={`${base}/work/${entry.id}`}
  class={`plate plate-card group flex h-full flex-col ${size === 'lead' ? 'lg:grid lg:grid-cols-[1.35fr_1fr]' : ''}`}
>
  <div class={`p-2 ${size === 'lead' ? 'lg:border-r lg:border-rule' : ''}`}>
    <div class="figure-well" style={`aspect-ratio: ${ratio};`}>
      {showImage ? (
        <img src={figureSrc} alt={figure!.alt} class={fitClass} loading={size === 'lead' ? 'eager' : 'lazy'} decoding="async" />
      ) : (
        <div class="flex h-full items-end p-4">
          <span class="eyebrow">{entry.data.artifact?.label ?? 'Figure pending'}</span>
        </div>
      )}
    </div>
  </div>

  <div class={`flex flex-1 flex-col ${size === 'lead' ? 'p-5 md:p-7' : 'p-4 md:p-5'}`}>
    <div class="flex items-baseline justify-between gap-3">
      <span class={`plate-roman ${size === 'lead' ? 'text-2xl' : 'text-lg'}`}>{toRoman(plate)}.</span>
      <span class="eyebrow">{categoryLabel[entry.data.category] ?? entry.data.category} · {entry.data.year}</span>
    </div>

    <h3 class={`display mt-3 ${size === 'lead' ? 'text-3xl md:text-4xl' : size === 'compact' ? 'text-xl' : 'text-2xl'}`}>
      {entry.data.title}
    </h3>
    <p class={`copy mt-3 flex-1 ${size === 'compact' ? 'text-sm' : 'text-sm md:text-[0.95rem]'}`}>{entry.data.blurb}</p>

    {stats.length > 0 && size !== 'compact' && (
      <ul class={`ledger mt-5 grid grid-cols-1 ledger-cols ${statCols}`}>
        {stats.map((item) => (
          <li class="px-0 py-2 text-xs leading-snug text-ink-soft sm:px-3 sm:first:pl-0">{item}</li>
        ))}
      </ul>
    )}

    <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
      {entry.data.status && <span class="tag tag-sage max-w-full !whitespace-normal">{entry.data.status}</span>}
      <span class="link-arrow ml-auto whitespace-nowrap">Open project <span class="arrow" aria-hidden="true">-&gt;</span></span>
    </div>
  </div>
</a>

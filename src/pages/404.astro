---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base title="Not found | Alex Schulz" description="This page is not on the map.">
  <section class="relative overflow-hidden">
    <div class="graticule absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative pb-20 pt-16 md:pb-28 md:pt-24">
      <p class="eyebrow eyebrow-signal">404 · Not found</p>
      <h1 class="display mt-5 max-w-3xl text-5xl md:text-7xl">Off the map.</h1>
      <p class="lede mt-5 max-w-xl text-lg md:text-xl">
        This page is not in the atlas. It may have moved when the site was reorganized.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${base}/work`} class="btn">See the work <span class="mono text-xs" aria-hidden="true">-&gt;</span></a>
        <a href={`${base}/`} class="btn-ghost">Home</a>
        <a href={`${base}/about`} class="btn-ghost">Story</a>
      </div>
    </div>
  </section>
</Base>

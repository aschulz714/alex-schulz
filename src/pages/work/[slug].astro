---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import CTA from '../../components/CTA.astro';
import { toRoman } from '../../lib/roman';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.hidden)).sort((a, b) => {
    const pa = a.data.plate ?? 999;
    const pb = b.data.plate ?? 999;
    if (pa !== pb) return pa - pb;
    return b.data.year - a.data.year;
  });
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      plateNumber: project.data.plate ?? index + 1,
      prev: index > 0 ? projects[index - 1] : null,
      next: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

const { project, plateNumber, prev, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const categoryLabel: Record<string, string> = {
  'ai-automation': 'AI + automation',
  'data-systems': 'Data system',
  geospatial: 'Geospatial',
  product: 'Product',
  python: 'Python / data',
  web: 'Web product',
};

const frame = [
  ['Question', project.data.caseStudy.question],
  ['Data', project.data.caseStudy.data],
  ['Method', project.data.caseStudy.method],
  ['Signal', project.data.caseStudy.signal],
  ['Why it matters', project.data.caseStudy.why],
];

const roman = toRoman(plateNumber);
const demo = project.data.links.demo;
const repo = project.data.links.repo;
const related = (await getCollection('analysis', ({ data }) => !data.draft && data.plates.includes(project.id)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title={`${project.data.title} · No. ${roman} | Alex Schulz`}
  description={project.data.description}
  current="work"
>
  <article>
    <header class="shell pt-10 md:pt-16">
      <a href={`${base}/work`} class="eyebrow inline-flex items-center gap-2 hover:text-signal">
        <span aria-hidden="true">&lt;-</span> All work
      </a>
      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_18rem] lg:items-end">
        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <span class="plate-roman text-3xl md:text-4xl">No. {roman}</span>
            <span class="eyebrow">{categoryLabel[project.data.category] ?? project.data.category} · {project.data.year}</span>
          </div>
          <h1 class="display mt-3 max-w-4xl text-4xl md:text-6xl">{project.data.title}</h1>
          <p class="lede mt-5 max-w-2xl text-base md:text-xl">{project.data.blurb}</p>
        </div>
        <div class="flex flex-col gap-3 lg:items-end">
          {project.data.status && <span class="tag tag-sage">{project.data.status}</span>}
          <div class="flex flex-wrap gap-2 lg:justify-end">
            {demo && <a href={demo} target="_blank" rel="noopener noreferrer" class="btn">Open the live demo</a>}
            {repo && <a href={repo} target="_blank" rel="noopener noreferrer" class="btn-ghost">Repository</a>}
          </div>
        </div>
      </div>
    </header>

    {project.data.figure && (
      <section class="shell mt-10 md:mt-14">
        <Figure figure={project.data.figure} label={`Fig. ${roman}`} eager={true} />
      </section>
    )}

    <section class="shell mt-12 grid grid-cols-1 gap-10 lg:mt-16 lg:grid-cols-[1fr_20rem] lg:gap-16">
      <div>
        <div class="atlas-rule !justify-start"><span>The frame</span></div>
        <dl class="mt-5">
          {frame.map(([label, value]) => (
            <div class="evidence-row">
              <dt class="eyebrow pt-0.5">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>

        <div class="prose-atlas mt-10 max-w-none text-[0.98rem]">
          <Content />
        </div>

        {project.data.confidentiality && (
          <p class="mt-10 border-l-2 border-signal pl-4 text-sm text-ink-muted">
            <span class="eyebrow eyebrow-signal block">Confidentiality</span>
            <span class="mt-1 block">{project.data.confidentiality}</span>
          </p>
        )}
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        {project.data.role && (
          <div>
            <p class="eyebrow">Role</p>
            <p class="mt-2 text-sm text-ink-soft">{project.data.role}</p>
          </div>
        )}
        {project.data.scale.length > 0 && (
          <div>
            <p class="eyebrow">Scale</p>
            <ul class="mt-2 space-y-2 border-t border-rule-soft">
              {project.data.scale.map((item) => (
                <li class="border-b border-rule-soft py-2 text-sm text-ink-soft">{item}</li>
              ))}
            </ul>
          </div>
        )}
        {project.data.proof.length > 0 && (
          <div>
            <p class="eyebrow">Proof</p>
            <ul class="mt-2 space-y-2">
              {project.data.proof.map((item) => (
                <li class="grid grid-cols-[0.9rem_1fr] gap-2 text-sm text-ink-soft">
                  <span class="mono text-signal" aria-hidden="true">+</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {project.data.tech.length > 0 && (
          <div>
            <p class="eyebrow">Stack</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {project.data.tech.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        )}
        {related.length > 0 && (
          <div>
            <p class="eyebrow">Analysis built on this project</p>
            <ul class="mt-2 space-y-2">
              {related.map((piece) => (
                <li><a href={`${base}/analysis/${piece.id}`} class="text-sm text-ink hover:text-signal">{piece.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </section>

    {project.data.gallery.length > 0 && (
      <section class="shell mt-14 md:mt-20">
        <div class="atlas-rule"><span>Further figures</span></div>
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
          {project.data.gallery.map((fig, i) => (
            <Figure figure={fig} label={`Fig. ${i + 1}`} />
          ))}
        </div>
      </section>
    )}

    {demo && project.data.embedDemo && (
      <section class="shell mt-14 md:mt-20">
        <div class="atlas-rule"><span>Live</span></div>
        <div class="mt-6">
          <Figure
            figure={{ kind: 'iframe', src: demo, alt: `${project.data.title} live demo`, ratio: '16/10', caption: 'Embedded live build. Opens full-size from the button above.' }}
            frame={true}
          />
        </div>
      </section>
    )}

    <nav class="shell mt-14 grid grid-cols-1 gap-4 border-t border-rule pt-6 sm:grid-cols-2 md:mt-20" aria-label="Neighboring projects">
      {prev ? (
        <a href={`${base}/work/${prev.id}`} class="group">
          <span class="eyebrow">&lt;- Previous</span>
          <span class="display mt-1 block text-xl group-hover:text-signal">{prev.data.title}</span>
        </a>
      ) : <span></span>}
      {next && (
        <a href={`${base}/work/${next.id}`} class="group text-left sm:text-right">
          <span class="eyebrow">Next -&gt;</span>
          <span class="display mt-1 block text-xl group-hover:text-signal">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>

  <CTA />
</Base>

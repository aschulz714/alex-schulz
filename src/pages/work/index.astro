---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PlateCard from '../../components/PlateCard.astro';
import CTA from '../../components/CTA.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const projects = (await getCollection('projects', ({ data }) => !data.hidden)).sort((a, b) => {
  const pa = a.data.plate ?? 999;
  const pb = b.data.plate ?? 999;
  if (pa !== pb) return pa - pb;
  return b.data.year - a.data.year;
});

// The first five in project order get cards; the rest are a plain list.
const top = projects.slice(0, 5);
const others = projects.slice(5);

const categoryLabel: Record<string, string> = {
  'ai-automation': 'AI + automation',
  'data-systems': 'Data system',
  geospatial: 'Geospatial',
  product: 'Product',
  python: 'Python / data',
  web: 'Web product',
};
---

<Base
  title="Work | Alex Schulz"
  description={`Five projects first: a national parcel store, a month-end close cockpit, a private trip-sharing app, Item2, and a live map of rail-served property in Washington. ${others.length} more below.`}
  current="work"
>
  <section class="shell pt-12 md:pt-20">
    <p class="eyebrow">Work</p>
    <h1 class="display mt-4 max-w-3xl text-4xl md:text-6xl">Five projects first.</h1>
    <p class="lede mt-5 max-w-2xl text-base md:text-lg">
      These are the five I'd show first. The other {others.length} are listed below them, each
      with its own page.
    </p>
  </section>

  <section class="shell pb-12 pt-8 md:pb-16">
    {top[0] && <PlateCard entry={top[0]} plate={top[0].data.plate ?? 1} size="lead" />}
    <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
      {top.slice(1).map((entry, index) => (
        <PlateCard entry={entry} plate={entry.data.plate ?? index + 2} size="compact" />
      ))}
    </div>
  </section>

  <section class="shell pb-16 md:pb-20">
    <div class="atlas-rule"><span>More projects</span></div>
    <ul class="mt-6 border-t border-rule">
      {others.map((entry) => (
        <li class="border-b border-rule">
          <a
            href={`${base}/work/${entry.id}`}
            class="group grid grid-cols-1 gap-x-8 gap-y-1 py-4 md:grid-cols-[1fr_2fr_auto] md:items-baseline"
          >
            <span class="display text-xl group-hover:text-signal md:text-2xl">{entry.data.title}</span>
            <span class="copy text-sm">{entry.data.blurb}</span>
            <span class="eyebrow md:text-right">{categoryLabel[entry.data.category] ?? entry.data.category} · {entry.data.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <CTA />
</Base>

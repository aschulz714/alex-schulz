---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PlateCard from '../../components/PlateCard.astro';
import CTA from '../../components/CTA.astro';

const projects = (await getCollection('projects', ({ data }) => !data.hidden)).sort((a, b) => {
  const pa = a.data.plate ?? 999;
  const pb = b.data.plate ?? 999;
  if (pa !== pb) return pa - pb;
  return b.data.year - a.data.year;
});

const categories = [
  ['all', 'All projects'],
  ['data-systems', 'Data systems'],
  ['geospatial', 'Geospatial'],
  ['ai-automation', 'AI + automation'],
  ['product', 'Product'],
  ['python', 'Python / data'],
] as const;

const present = new Set(projects.map((p) => p.data.category));
const chips = categories.filter(([key]) => key === 'all' || present.has(key as any));
---

<Base
  title="Work · Selected projects | Alex Schulz"
  description="Every project on the site: national parcel coverage, the wealth atlas, rail-served properties, Item2, satellite commodity signals, and the systems built around them."
  current="work"
>
  <section class="shell pt-12 md:pt-20">
    <p class="eyebrow">Work · {projects.length} projects</p>
    <h1 class="display mt-4 max-w-3xl text-4xl md:text-6xl">Selected work, numbered like an atlas.</h1>
    <p class="lede mt-5 max-w-2xl text-base md:text-lg">
      Each project states its question, its inputs, its method, and what it proved. The order is
      roughly by weight: the national parcel store first, the early maps and a family trip app last.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter projects by category">
      {chips.map(([key, label]) => (
        <button type="button" class="chip" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>
          {label}
        </button>
      ))}
    </div>
  </section>

  <section class="shell pb-16 pt-8 md:pb-20">
    <ol class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" id="plate-grid">
      {projects.map((entry, index) => (
        <li data-category={entry.data.category} class={index === 0 ? 'md:col-span-2 lg:col-span-3' : ''}>
          <PlateCard entry={entry} plate={entry.data.plate ?? index + 1} size={index === 0 ? 'lead' : 'std'} />
        </li>
      ))}
    </ol>
  </section>

  <CTA />
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-filter]');
  const items = document.querySelectorAll<HTMLLIElement>('#plate-grid > li');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));
      items.forEach((item) => {
        const show = key === 'all' || item.dataset.category === key;
        item.classList.toggle('hidden', !show);
      });
    });
  });
</script>

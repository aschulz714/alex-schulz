---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PlateCard from '../components/PlateCard.astro';
import Figure from '../components/Figure.astro';
import Method from '../components/Method.astro';
import CTA from '../components/CTA.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.plate !== undefined && !entry.data.hidden)
  .sort((a, b) => (a.data.plate ?? 99) - (b.data.plate ?? 99));

// The five shown on the home page are the first five in project order.
const lead = projects[0];
const rest = projects.slice(1, 5);
const more = projects.length - 5;

// Where the skills come from. Every item is stated elsewhere on the site
// (Story page, life timeline, Hodego project page), except the Maryland tools,
// which are the ones used in my own coursework files.
const background: [string, string, string][] = [
  ['CPA', 'Washington license', 'Ten years of accounting inside companies: film, a family office, real estate, aerospace, a marketplace.'],
  ['Hodego', 'Co-founder and technical delivery lead', 'Three developers. TypeScript, React, LoopBack 4, Stripe, Agora, AWS.'],
  ['Maryland', 'MS, Geospatial Intelligence · 4.0', 'Python, ArcPy, NumPy, GeoPandas, R, ArcGIS, Google Earth Engine. Capstone: an interactive map of rail-served real estate.'],
  ['Kentucky', 'Graduate Certificate, Digital Mapping · 4.0', 'HTML, CSS, JavaScript, Git, QGIS, Leaflet, Mapbox.'],
];
---

<Base current="home">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="graticule absolute inset-0" aria-hidden="true"></div>
    <div class="shell relative pb-10 pt-12 md:pb-14 md:pt-20">
      <p class="eyebrow">Lake Stevens, Washington</p>
      <h1 class="display mt-5 max-w-4xl text-5xl sm:text-6xl lg:text-7xl">
        I'm a CPA who builds practical software with AI.
      </h1>
      <div class="mt-7 grid grid-cols-1 gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
        <p class="lede max-w-2xl text-lg md:text-xl">
          I use AI to write Python steps that run the same way every time, so the result can be
          checked. Where a step has one right answer, the model writes the code and never
          improvises the result. I learn how the work gets done, design the system, and verify
          what comes out.
        </p>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href="#work" class="btn">See the work <span class="mono text-xs" aria-hidden="true">-&gt;</span></a>
          <a href={`${base}/about`} class="btn-ghost">Read the story</a>
        </div>
      </div>

      <dl class="ledger ledger-cols mt-10 grid grid-cols-1 sm:grid-cols-4">
        {background.map(([name, what, detail]) => (
          <div class="px-0 py-4 sm:px-4 sm:first:pl-0">
            <dt class="display text-2xl md:text-3xl">{name}</dt>
            <dd class="mt-2 text-sm leading-snug text-ink-soft">
              <span class="font-semibold text-ink">{what}</span>
              <span class="mt-1 block">{detail}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="shell pb-14 pt-4 md:pb-20 md:pt-6">
    <div class="atlas-rule"><span>Selected work</span></div>
    <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
      <h2 class="display max-w-2xl text-3xl md:text-5xl">Five to start with.</h2>
      <a href={`${base}/work`} class="link-arrow">{more} more projects <span class="arrow" aria-hidden="true">-&gt;</span></a>
    </div>

    {lead && (
      <div class="reveal mt-10">
        <PlateCard entry={lead} plate={lead.data.plate ?? 1} size="lead" />
      </div>
    )}

    <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
      {rest.map((entry) => (
        <div class="reveal">
          <PlateCard entry={entry} plate={entry.data.plate ?? 99} size="compact" />
        </div>
      ))}
    </div>
  </section>

  <Method />

  <!-- Story teaser -->
  <section class="shell py-14 md:py-20">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[1fr_1.2fr] md:items-center md:gap-14">
      <Figure
        figure={{
          src: 'images/industrial-map-of-washington.jpeg',
          alt: 'Framed Industrial Map of the State of Washington, circa 1940, from the family dairy farm in Custer, WA',
          caption: 'Industrial Map of Washington, c. 1940. Custer, WA.',
          ratio: '4/3',
        }}
        label="Frontispiece"
      />
      <div>
        <div class="atlas-rule !justify-start"><span>Story</span></div>
        <h2 class="display mt-6 text-3xl md:text-4xl">Why the work keeps returning to maps.</h2>
        <p class="copy mt-4 text-base">
          An industrial map from my great-grandparents' dairy farm hung on the porch by a thumbtack.
          It shows industry, land, movement, and memory at once. Ten years of accounting inside
          film production, a billionaire's family office, real-estate development, and aerospace
          taught me how real money keeps its books. Two geospatial degrees taught me where the
          assets actually sit. Most of what I build is where those two habits meet.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a href={`${base}/about#timeline`} class="link-arrow">The timeline <span class="arrow" aria-hidden="true">-&gt;</span></a>
          <a href={`${base}/about`} class="link-arrow">The long version <span class="arrow" aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Base>

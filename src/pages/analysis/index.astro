---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

const pieces = (await getCollection('analysis', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const verticalLabel: Record<string, string> = {
  parcels: 'Parcels & ownership',
  'data-centers': 'Data centers',
  power: 'Power & grid',
  wealth: 'Wealth formation',
  method: 'Method',
};

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Analysis · Published findings | Alex Schulz"
  description="Short analytical pieces built on public records: parcel ownership, land around data centers, and the method behind each finding, with the limits stated."
  current="analysis"
>
  <section class="shell pt-12 md:pt-20">
    <p class="eyebrow">Analysis · {pieces.length} {pieces.length === 1 ? 'piece' : 'pieces'}</p>
    <h1 class="display mt-4 max-w-3xl text-4xl md:text-6xl">Findings, with the method and the limits attached.</h1>
    <p class="lede mt-5 max-w-2xl text-base md:text-lg">
      Each piece answers one question from public records and states what was checked and what
      was not. Depth in one vertical at a time: land and ownership first, the assets that sit on
      it next.
    </p>
  </section>

  <section class="shell pb-16 pt-10 md:pb-20">
    <ol class="border-t border-rule">
      {pieces.map((piece) => (
        <li class="border-b border-rule-soft">
          <a href={`${base}/analysis/${piece.id}`} class="group grid grid-cols-1 gap-3 py-7 md:grid-cols-[9rem_1fr_auto] md:items-baseline md:gap-8">
            <span class="eyebrow">{dateFmt.format(piece.data.date)}</span>
            <span>
              <span class="display block text-2xl md:text-3xl group-hover:text-signal">{piece.data.title}</span>
              <span class="copy mt-2 block max-w-2xl text-sm md:text-base">{piece.data.dek}</span>
              {piece.data.tags.length > 0 && (
                <span class="mt-3 flex flex-wrap gap-1.5">
                  {piece.data.tags.map((t) => <span class="tag">{t}</span>)}
                </span>
              )}
            </span>
            <span class="tag tag-signal">{verticalLabel[piece.data.vertical]}</span>
          </a>
        </li>
      ))}
    </ol>
    {pieces.length === 0 && <p class="copy mt-6">First pieces are in preparation.</p>}
  </section>

  <CTA />
</Base>

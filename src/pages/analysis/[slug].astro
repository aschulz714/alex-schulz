---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import CTA from '../../components/CTA.astro';
import { toRoman } from '../../lib/roman';

export async function getStaticPaths() {
  const pieces = await getCollection('analysis', ({ data }) => !data.draft);
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const verticalLabel: Record<string, string> = {
  parcels: 'Parcels & ownership',
  'data-centers': 'Data centers',
  power: 'Power & grid',
  wealth: 'Wealth formation',
  method: 'Method',
};

const frame = [
  ['Question', piece.data.frame.question],
  ['Data', piece.data.frame.data],
  ['Method', piece.data.frame.method],
  ['Finding', piece.data.frame.finding],
  ['Limits', piece.data.frame.limits],
];

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const allPlates = await getCollection('projects');
const plates = piece.data.plates
  .map((id) => allPlates.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Base
  title={`${piece.data.title} | Analysis · Alex Schulz`}
  description={piece.data.dek}
  current="analysis"
>
  <article>
    <header class="shell-narrow pt-10 md:pt-16">
      <a href={`${base}/analysis`} class="eyebrow inline-flex items-center gap-2 hover:text-signal">
        <span aria-hidden="true">&lt;-</span> All analysis
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="tag tag-signal">{verticalLabel[piece.data.vertical]}</span>
        <span class="eyebrow">{dateFmt.format(piece.data.date)}</span>
      </div>
      <h1 class="display mt-4 text-4xl md:text-6xl">{piece.data.title}</h1>
      <p class="lede mt-5 text-lg md:text-xl">{piece.data.dek}</p>
    </header>

    {piece.data.figure && (
      <section class="shell mt-10 md:mt-14">
        <Figure figure={piece.data.figure} label="Fig. 1" eager={true} />
      </section>
    )}

    <section class="shell-narrow mt-10 md:mt-14">
      <div class="atlas-rule !justify-start"><span>The frame</span></div>
      <dl class="mt-5">
        {frame.map(([label, value]) => (
          <div class="evidence-row">
            <dt class="eyebrow pt-0.5">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>

      <div class="prose-atlas mt-10 text-[1.02rem]">
        <Content />
      </div>

      {plates.length > 0 && (
        <div class="mt-12 border-t border-rule pt-6">
          <p class="eyebrow">Built on</p>
          <ul class="mt-3 space-y-2">
            {plates.map((p) => (
              <li>
                <a href={`${base}/work/${p.id}`} class="group inline-flex items-baseline gap-3">
                  <span class="plate-roman text-sm">{p.data.plate ? toRoman(p.data.plate) : '—'}.</span>
                  <span class="display text-xl group-hover:text-signal">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </article>

  <CTA />
</Base>

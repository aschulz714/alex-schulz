---
import '../styles/v2.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alex Schulz — v2 redesign preview',
  description = 'Redesign exploration for the Alex Schulz portfolio site.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen text-ink">
    <header class="fixed top-0 left-0 right-0 z-40 bg-paper/85 backdrop-blur-xl">
      <nav class="section-shell-v2 flex items-center justify-between gap-5 py-4">
        <a href="/" class="text-base font-semibold tracking-tight">
          Alex Schulz
        </a>
        <div class="flex items-center gap-2 text-sm">
          <a href="/" class="hidden rounded-full px-4 py-2 text-ink-muted hover:text-ink transition-colors sm:inline-block">
            ← Back to v1
          </a>
          <a href="mailto:alex.j.schulz@gmail.com" class="button-v2-primary">Contact</a>
        </div>
      </nav>
    </header>

    <main id="main-content" class="pt-20">
      <slot />
    </main>

    <footer class="border-t border-hairline py-12">
      <div class="section-shell-v2 flex flex-col gap-3 text-sm text-ink-muted md:flex-row md:items-center md:justify-between">
        <span>Lake Stevens, WA · v2 redesign preview</span>
        <a href="/" class="hover:text-accent transition-colors">Compare to v1</a>
      </div>
    </footer>
  </body>
</html>

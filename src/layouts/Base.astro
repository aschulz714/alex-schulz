---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const OG_IMAGE_VERSION = 3;

const {
  title = 'Alex Schulz | CPA, Geospatial, Developer',
  description = 'A living resume and portfolio from Alex Schulz: CPA, geospatial intelligence graduate, and builder at the intersection of finance and physical-world data.',
  ogImage = 'og-image.png',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://aschulz714.github.io/';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = `${siteUrl}${ogImage}?v=${OG_IMAGE_VERSION}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Alex Schulz" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 button-primary"
    >
      Skip to content
    </a>

    <header class="fixed top-0 left-0 right-0 z-40 border-b border-hairline bg-paper/92 backdrop-blur-xl">
      <nav class="section-shell flex items-center justify-between gap-3 py-3">
        <a href="/" class="group min-w-0">
          <span class="block text-sm font-semibold leading-none">
            <span class="sm:hidden">AS</span>
            <span class="hidden sm:inline">Alex Schulz</span>
          </span>
          <span class="mt-1 hidden text-xs text-ink-muted sm:block">CPA / GEOINT / builder</span>
        </a>
        <a href="mailto:alex.j.schulz@gmail.com" class="rounded-sm bg-ink px-3 py-2 text-sm text-paper-soft transition-colors hover:bg-accent">Contact</a>
      </nav>
      <div class="border-t border-hairline/80">
        <div class="section-shell overflow-x-auto py-2">
          <div class="flex min-w-max items-center gap-1 text-xs text-ink-soft sm:text-sm">
            <a href="/entertainment" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">Entertainment</a>
            <a href="/geospatial" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">Geospatial</a>
            <a href="/finance" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">Finance</a>
            <span class="mx-1 h-5 w-px bg-hairline" aria-hidden="true"></span>
            <a href="/franchise-index" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">
              <span class="sm:hidden">Index</span>
              <span class="hidden sm:inline">Franchise Index</span>
            </a>
            <a href="/work" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">Work</a>
            <a href="/about" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">About</a>
            <a href="/resume.pdf" class="rounded-sm px-2.5 py-1.5 transition-colors hover:bg-accent-soft hover:text-accent sm:px-3">Resume</a>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="pt-28">
      <slot />
    </main>

    <footer class="border-t border-hairline bg-paper-soft/55">
      <div class="section-shell py-10 md:py-12 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="coord">47.9790 N / 122.2021 W / Lake Stevens, WA</p>
          <p class="mt-2 max-w-lg text-sm text-ink-muted">
            Living resume, portfolio, and working notebook for finance, geospatial data, and product experiments.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 text-sm">
          <a href="/resume.pdf" class="button-secondary">Resume</a>
          <a href="mailto:alex.j.schulz@gmail.com" class="button-primary">Email</a>
        </div>
      </div>
    </footer>

    <script>
      const revealables = document.querySelectorAll<HTMLElement>('.reveal');
      if (revealables.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '-10% 0px -10% 0px', threshold: 0 }
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

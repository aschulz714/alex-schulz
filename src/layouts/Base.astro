---
import '../styles/global.css';
import { contact, resumePath, homeCoords } from '../data/site';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  current?: 'home' | 'work' | 'about';
}

const OG_IMAGE_VERSION = 6;

const {
  title = 'Alex Schulz | A CPA who builds working apps, data pipelines, and accounting automation with AI',
  description =
    'Alex Schulz is a CPA who builds working apps, data pipelines, and accounting automation with AI: a 143.9-million-record national parcel store, a month-end close cockpit, a private trip-sharing app in pilot, and Item2.',
  ogImage = 'og-image.png',
  current,
} = Astro.props;

const { email, linkedIn: linkedInUrl, github: githubUrl } = contact;

const siteUrl = Astro.site?.toString() ?? 'https://aschulz714.github.io/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const resumeUrl = resumePath ? `${base}/${resumePath}` : null;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = `${new URL(`${base}/${ogImage}`, siteUrl).toString()}?v=${OG_IMAGE_VERSION}`;

const nav: { key: NonNullable<Props['current']>; label: string; href: string }[] = [
  { key: 'work', label: 'Work', href: `${base}/work` },
  { key: 'about', label: 'Story', href: `${base}/about` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Alex Schulz" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen text-ink">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-rule bg-paper">
      <nav class="shell flex items-center justify-between gap-4 py-3">
        <a href={`${base}/`} class="group flex min-w-0 items-baseline gap-3">
          <span class="display text-lg leading-none sm:text-xl">Alex Schulz</span>
          <span class="eyebrow hidden md:inline">CPA · MS GEOINT</span>
        </a>
        <div class="flex items-center gap-0 sm:gap-1">
          {nav.map((item) => (
            <a
              href={item.href}
              class="nav-link !px-2 sm:!px-3"
              aria-current={current === item.key ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          {resumeUrl && <a href={resumeUrl} class="nav-link hidden sm:inline-block">Resume</a>}
          <a href={`mailto:${email}`} class="btn ml-1 !min-h-9 !px-3 !py-2 text-xs sm:ml-2">Contact</a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-20 border-t border-rule bg-paper-deep/40">
      <div class="shell grid grid-cols-1 gap-8 py-12 md:grid-cols-[1.2fr_1fr_1fr]">
        <div>
          <p class="display text-2xl">Alex Schulz</p>
          <p class="eyebrow mt-2">Lake Stevens, WA · {homeCoords}</p>
          <p class="copy mt-4 max-w-md text-sm">
            A CPA who builds working apps, data pipelines, and accounting automation with AI, and shows where the numbers come from.
          </p>
        </div>
        <div>
          <p class="eyebrow">Site</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="foot-link hover:text-signal" href={`${base}/work`}>Work · selected projects</a></li>
            <li><a class="foot-link hover:text-signal" href={`${base}/about`}>Story · the long version</a></li>
            {resumeUrl && <li><a class="hover:text-signal" href={resumeUrl}>Resume (PDF)</a></li>}
          </ul>
        </div>
        <div>
          <p class="eyebrow">Elsewhere</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="foot-link hover:text-signal" href={linkedInUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a class="foot-link hover:text-signal" href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a class="foot-link hover:text-signal" href={`mailto:${email}`}>{email}</a></li>
          </ul>
        </div>
      </div>
      <div class="shell">
        <p class="eyebrow border-t border-rule-soft py-4">Edition 2026 · Built with Astro · Figures rendered from public records</p>
      </div>
    </footer>

    <script>
      const revealables = document.querySelectorAll<HTMLElement>('.reveal');
      if (revealables.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '-6% 0px -6% 0px', threshold: 0 }
        );
        revealables.forEach((element) => observer.observe(element));
      } else {
        revealables.forEach((element) => element.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
